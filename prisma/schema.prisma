// Schema do sistema de gestão da Marcenaria Carmel

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StatusProducao {
  FILA
  PRODUCAO
  ACABAMENTO
  ENTREGA
  CONCLUIDO
}

enum CategoriaCusto {
  MATERIA_PRIMA
  FERRAGENS_ACABAMENTO
  MAO_DE_OBRA
  TERCEIRIZADOS
  OUTROS
}

model Usuario {
  id        String   @id @default(cuid())
  nome      String
  email     String   @unique
  senhaHash String
  criadoEm  DateTime @default(now())

  projetos Projeto[] @relation("ProjetoResponsavel")
}

model Projeto {
  id                String          @id @default(cuid())
  nome              String
  cliente           String
  descricao         String?
  valorVenda        Float
  percentualImposto Float           @default(0) // % de imposto/comissão descontado do valor de venda
  dataFechamento    DateTime
  prazoEntrega      DateTime
  dataEntregaReal   DateTime?
  statusProducao    StatusProducao  @default(FILA)
  responsavelId     String?
  responsavel       Usuario?        @relation("ProjetoResponsavel", fields: [responsavelId], references: [id])
  criadoEm          DateTime        @default(now())
  atualizadoEm      DateTime        @updatedAt

  custos     Custo[]
  orcamentos OrcamentoCusto[]
}

model Custo {
  id          String         @id @default(cuid())
  projetoId   String
  projeto     Projeto        @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  categoria   CategoriaCusto
  descricao   String
  valor       Float
  data        DateTime       @default(now())
}

model OrcamentoCusto {
  id        String         @id @default(cuid())
  projetoId String
  projeto   Projeto        @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  categoria CategoriaCusto
  valor     Float

  @@unique([projetoId, categoria])
}

model MetaMensal {
  id           String   @id @default(cuid())
  ano          Int
  mes          Int // 1-12
  valorMeta    Float

  @@unique([ano, mes])
}
