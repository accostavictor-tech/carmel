# Copie este arquivo para .env e ajuste os valores.

# Caminho do banco SQLite. Use um caminho ABSOLUTO — o Prisma CLI resolve
# caminhos relativos a partir de prisma/schema.prisma, enquanto o Next.js
# em runtime resolve a partir da raiz do projeto, então um caminho relativo
# aponta para arquivos diferentes nos dois casos.
DATABASE_URL="file:/caminho/absoluto/para/o/projeto/prisma/dev.db"

# Chave usada pelo NextAuth para assinar sessões. Gere uma com:
#   openssl rand -base64 32
AUTH_SECRET=""
