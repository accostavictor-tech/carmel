# Copie este arquivo para .env e ajuste os valores.

# Connection string do Postgres. Se estiver usando Vercel Postgres/Neon,
# use a URL "pooled" (via PgBouncer) aqui.
#   Vercel Postgres: valor de POSTGRES_PRISMA_URL
#   Neon direto: a "Pooled connection string" do dashboard
DATABASE_URL="postgresql://usuario:senha@host/banco?sslmode=require"

# Connection string DIRETA (sem pooler), usada só pelas migrations do Prisma.
#   Vercel Postgres: valor de POSTGRES_URL_NON_POOLING
#   Neon direto: a "Direct connection string" do dashboard
DIRECT_URL="postgresql://usuario:senha@host/banco?sslmode=require"

# Chave usada pelo NextAuth para assinar sessões. Gere uma com:
#   openssl rand -base64 32
AUTH_SECRET=""
