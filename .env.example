# Copie este arquivo para .env e ajuste os valores.

# Connection string do Postgres.
#   Prisma Postgres (Vercel Marketplace): valor de DATABASE_URL ou
#     DATABASE_POSTGRES_URL gerado ao conectar o banco ao projeto
#   Neon/Supabase/outro: a connection string do dashboard do provedor
DATABASE_URL="postgresql://usuario:senha@host/banco?sslmode=require"

# Chave usada pelo NextAuth para assinar sessões. Gere uma com:
#   openssl rand -base64 32
AUTH_SECRET=""
